{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageUploadMonitorRole",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:CreateRole", "iam:PutRolePolicy"],
      "Resource": "arn:aws:iam::213598695875:role/AQUploadFreshnessMonitorRole"
    },
    {
      "Sid": "PassUploadMonitorRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::213598695875:role/AQUploadFreshnessMonitorRole",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    },
    {
      "Sid": "DeployUploadMonitorLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-west-2:213598695875:function:aq-upload-freshness-monitor"
    },
    {
      "Sid": "AllowEventBridgeInvokeGrantOnly",
      "Effect": "Allow",
      "Action": "lambda:AddPermission",
      "Resource": "arn:aws:lambda:us-west-2:213598695875:function:aq-upload-freshness-monitor",
      "Condition": {
        "StringEquals": {
          "lambda:Principal": "events.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ScheduleUploadMonitor",
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:PutTargets"],
      "Resource": "arn:aws:events:us-west-2:213598695875:rule/aq-upload-freshness-hourly"
    }
  ]
}
